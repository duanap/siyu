NODE_ENV=production

# Copy to a secret-managed path outside Git, replace every placeholder, and never commit the result.
DATABASE_URL=postgresql://siyu:replace-with-database-password@db.internal:5432/siyu?sslmode=require
REDIS_URL=rediss://:replace-with-redis-password@cache.internal:6380
JWT_SECRET=replace-with-at-least-32-random-characters

SIYU_PUBLIC_URL=https://your-siyu-domain.example
SIYU_ADMIN_URL=https://your-siyu-domain.example/admin/
SIYU_CORS_ORIGINS=https://your-siyu-domain.example
SIYU_COOKIE_SECURE=true

SIYU_API_HOST=127.0.0.1
SIYU_API_PORT=3000
SIYU_API_ORIGIN=http://127.0.0.1:3000
SIYU_GATEWAY_HOST=127.0.0.1
SIYU_GATEWAY_PORT=8080

SIYU_QQ_CLIENT_ID=replace-with-qq-app-id
SIYU_QQ_CLIENT_SECRET=replace-with-qq-app-key
SIYU_QQ_CALLBACK_URL=https://your-siyu-domain.example/api/v1/auth/qq/callback

# TASK-025 release preflight intentionally fails until an approved production adapter is implemented.
SIYU_MAIL_PROVIDER=
SIYU_MAIL_FROM=

SIYU_RECURRING_SCAN_INTERVAL_MS=60000
SIYU_RECURRING_SCAN_BATCH_SIZE=200
SIYU_RECURRING_WORKER_CONCURRENCY=8
SIYU_RECURRING_JOB_ATTEMPTS=5
SIYU_RECURRING_BACKOFF_DELAY_MS=1000
